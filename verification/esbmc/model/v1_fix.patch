 import traci
 import sumolib
 
+WARMUP_STEPS = 10  # seconds simulated in reset() before the first decision
+Y_MIN = 3          # minimum yellow time in seconds
+
+
+def _first_switch_point(start, delta_time, min_green):
+    """Smallest phase_duration >= min_green reachable from `start` in steps of delta_time."""
+    if start >= min_green:
+        return start
+    k = (min_green - start + delta_time - 1) // delta_time
+    return start + k * delta_time
+
 
